# Copy to infra/.env.prod (git-ignored) and fill in, or let infra/deploy.sh write it for you.
# Never commit the real file.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The address people open. With HTTPS (profile "https"): https://your-domain. Caddy serves the
# API under /api on the same address. Local test without Caddy: http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# true whenever PUBLIC_WEB_URL is https:// (the session cookie is then HTTPS-only).
COOKIE_SECURE=false

# AI model key (fact extraction for demo cases, hearings). Optional.
GEMINI_API_KEY=
# Keep false until a model that keeps no data is configured: real buyers' documents are then
# never sent to the model.
NYAYASIM_PRIVATE_LLM_OK=false

# "Continue with Google" (optional). Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application. Authorized redirect URI: <PUBLIC_WEB_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email for sign-up confirmation and password reset. Required for a public site.
# Any SMTP provider works (e.g. Brevo, Amazon SES, Gmail with an app password). Port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NyayaSim <no-reply@example.com>

# Ports are bound to this machine only by default. Use WEB_BIND=0.0.0.0 only behind a firewall.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# HTTPS profile only:
DOMAIN=
# Caddyfile = public site with accounts. Caddyfile.locked = also one shared password in front.
CADDYFILE=Caddyfile
BASIC_AUTH_USER=nyayasim
BASIC_AUTH_HASH=
