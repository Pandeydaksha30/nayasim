# Copy to infra/.env.prod (git-ignored) and fill in. Never commit the real file.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where people open the website, and where their browser reaches the API.
# Local test:  http://localhost:3000  and  http://localhost:8000
# With HTTPS (profile "https"): both are https://example.com — Caddy serves the API under /api
# on the same address, so the site password covers every request.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# AI model key (fact extraction for demo cases, hearings).
GEMINI_API_KEY=

# Keep false until a model that keeps no data is configured: real buyers' documents are then
# never sent to the model.
NYAYASIM_PRIVATE_LLM_OK=false

# Ports are bound to this machine only by default. Use 0.0.0.0 only behind a firewall/proxy.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
# Host ports (change if 8000/3000 are taken).
API_PORT=8000
WEB_PORT=3000

# HTTPS profile only:
DOMAIN=
BASIC_AUTH_USER=nyayasim
BASIC_AUTH_HASH=
