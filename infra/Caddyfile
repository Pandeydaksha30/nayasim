# HTTPS for {$DOMAIN}: automatic certificates, one address for website + API.
# /api/* and /health go to the API, everything else to the website, so the session cookie is
# first-party and every request is same-origin. Users sign in with their own accounts.
# To also put the whole site behind one shared password (private demo), use Caddyfile.locked
# (set CADDYFILE=Caddyfile.locked in infra/.env.prod).

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 26MB
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
