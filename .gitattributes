# Files that run on Linux servers/containers must keep LF line endings, even when checked out
# or archived on Windows (core.autocrlf=true would otherwise turn them into CRLF and break them).
*.sh            text eol=lf
Dockerfile      text eol=lf
Caddyfile*      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env*.example   text eol=lf
