# Copy to backend/.env and adjust. Every variable is prefixed NYAYASIM_.

# Browser origins allowed to call the API (comma-separated).
NYAYASIM_CORS_ORIGINS=http://localhost:3100

# Postgres + pgvector (infra/docker-compose.yml). Use 127.0.0.1, not localhost, on Windows.
NYAYASIM_DATABASE_URL=postgresql+psycopg://nyayasim:nyayasim_local_only@127.0.0.1:5432/nyayasim?connect_timeout=10

# Set to 1 to make database tests fail (not skip) when Postgres is down.
# NYAYASIM_REQUIRE_DB=1
