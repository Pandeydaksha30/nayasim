# Copy to backend/.env and adjust. Every variable is prefixed NYAYASIM_.

# Browser origins allowed to call the API (comma-separated).
NYAYASIM_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Postgres + pgvector (infra/docker-compose.yml). Use 127.0.0.1, not localhost, on Windows.
NYAYASIM_DATABASE_URL=postgresql+psycopg://nyayasim:nyayasim_local_only@127.0.0.1:5432/nyayasim?connect_timeout=10

# Set to 1 to make database tests fail (not skip) when Postgres is down.
# NYAYASIM_REQUIRE_DB=1

# ── Accounts ──
# Address of the website (links in emails, Google redirect). Local dev: the Next.js dev server.
NYAYASIM_PUBLIC_URL=http://localhost:3100
# true only when served over HTTPS.
NYAYASIM_COOKIE_SECURE=false
# Optional "Continue with Google". Redirect URI to register: http://localhost:3100/api/v1/auth/google/callback
NYAYASIM_GOOGLE_CLIENT_ID=
NYAYASIM_GOOGLE_CLIENT_SECRET=
# Optional SMTP. Empty: emails are saved to data/outbox/ and their links printed in the API window.
NYAYASIM_SMTP_HOST=
NYAYASIM_SMTP_PORT=587
NYAYASIM_SMTP_USER=
NYAYASIM_SMTP_PASSWORD=
NYAYASIM_SMTP_FROM=NyayaSim <no-reply@localhost>
